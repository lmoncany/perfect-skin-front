---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const url = Astro.url.href;
---

{
  SHARE_LINKS.length > 0 && (
    <div class="flex flex-none flex-col items-start justify-center gap-2">
      <span class="text-sm font-medium text-foreground/70 italic">
        Partager cet article :
      </span>
      <div>
        {SHARE_LINKS.map(social => (
          <LinkButton
            href={`${social.href}${encodeURIComponent(url)}`}
            class="scale-90 p-2 hover:rotate-6 sm:p-1"
            title={social.linkTitle}
          >
            <social.icon class="inline-block size-6 fill-transparent stroke-current stroke-2 opacity-90 sm:scale-110" />
            <span class="sr-only">{social.linkTitle}</span>
          </LinkButton>
        ))}
      </div>
    </div>
  )
}
