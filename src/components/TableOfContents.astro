---
import type { TocItem } from "@/lib/toc";

interface Props {
  items: TocItem[];
  minItems?: number;
}

const { items, minItems = 3 } = Astro.props;
const h2Count = items.filter(i => i.level === 2).length;
const shouldShow = h2Count >= minItems;
---

{
  shouldShow && (
    <details
      class="my-10 border border-border/30 bg-surface px-6 py-5 text-sm"
      open
    >
      <summary class="cursor-pointer list-none font-accent text-[11px] font-medium tracking-[0.15em] text-foreground/40 uppercase marker:hidden">
        Dans cet article
      </summary>
      <nav
        aria-label="Table des matières"
        class="mt-4 border-t border-border/20 pt-4"
      >
        <ol class="space-y-2">
          {items.map(item => (
            <li class={item.level === 3 ? "ms-5 text-foreground/50" : "text-foreground/70"}>
              <a
                href={`#${item.id}`}
                class="hover:text-accent transition-colors duration-300"
              >
                {item.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}
