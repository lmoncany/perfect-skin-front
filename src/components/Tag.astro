---
import IconHash from "@/assets/icons/IconHash.svg";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/tag/${tag}/`}
    transition:name={tag}
    class:list={[
      "inline-flex items-center gap-1 border border-border/40 px-3 py-1 font-accent tracking-wide uppercase",
      "hover:border-accent hover:text-accent transition-colors duration-300",
      { "text-[10px]": size === "sm" },
      { "text-xs": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-40",
        { "size-3": size === "sm" },
        { "size-4": size === "lg" },
      ]}
    />
    <span>{tagName}</span>
  </a>
</li>
