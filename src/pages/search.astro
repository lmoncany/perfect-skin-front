---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import { SITE } from "@/config";
import { getAllPosts } from "@/lib/content";
import type { Post } from "@/lib/types";

function normalizeText(value: string): string {
  return value
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/['’`]/g, "")
    .replace(/[^a-z0-9]+/gi, " ")
    .toLowerCase()
    .trim();
}

function scorePost(post: Post, query: string): number {
  const haystack = normalizeText(
    [
      post.title,
      post.excerpt,
      post.content.replace(/<[^>]*>/g, " "),
      post.author.name,
      ...(post.categories ?? []),
      ...(post.tags ?? []),
      ...(post.brands ?? []),
    ].join(" ")
  );

  let score = 0;
  const tokens = query.split(/\s+/).filter(Boolean);
  for (const token of tokens) {
    if (haystack.includes(token)) score += 1;
    if (normalizeText(post.title).includes(token)) score += 3;
    if (normalizeText(post.excerpt).includes(token)) score += 2;
  }
  return score;
}

const rawQuery = Astro.url.searchParams.get("q")?.trim() ?? "";
const query = rawQuery.replace(/\s+/g, " ");
const allPosts = await getAllPosts();

const results =
  query.length > 0
    ? allPosts
        .map(post => ({ post, score: scorePost(post, query.toLowerCase()) }))
        .filter(result => result.score > 0)
        .sort(
          (a, b) =>
            b.score - a.score ||
            new Date(b.post.date).getTime() - new Date(a.post.date).getTime()
        )
        .map(result => result.post)
    : allPosts.slice(0, 12);

const title = query
  ? `Recherche: ${query} — ${SITE.title}`
  : `Recherche — ${SITE.title}`;
const description = query
  ? `Résultats de recherche pour « ${query} » sur ${SITE.title}.`
  : "Parcourez tous nos guides, tests et comparatifs beauté.";
---

<Layout title={title} description={description}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <h1 class="mt-8 display-lg mb-2">Rechercher</h1>
    <p class="mt-2 text-foreground/50 font-light">
      Parcourez tous nos guides, tests et comparatifs beauté.
    </p>

    <form method="get" class="mt-6 flex flex-col gap-3 sm:flex-row">
      <input
        type="search"
        name="q"
        value={query}
        placeholder="Rechercher un article…"
        class="w-full rounded border border-border bg-background px-4 py-3 text-sm outline-none transition-colors focus:border-accent"
      />
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded bg-accent px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-accent/90"
      >
        Rechercher
      </button>
    </form>

    <div class="mt-8 flex items-center justify-between gap-4">
      <p class="text-sm text-foreground/60">
        {query
          ? `${results.length} résultat${results.length > 1 ? "s" : ""} pour « ${query} »`
          : "Articles récents"}
      </p>
      {query && (
        <a href="/search/" class="text-sm text-accent hover:underline">
          Réinitialiser
        </a>
      )}
    </div>

    {results.length > 0 ? (
      <div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {results.map(post => (
          <Card post={post} variant="h3" />
        ))}
      </div>
    ) : (
      <p class="py-20 text-center text-foreground/40 text-base font-light">
        Aucun résultat pour cette recherche.
      </p>
    )}
  </main>
  <Footer />
</Layout>
