---
import Layout from "@/layouts/Layout.astro";
import { getAllPosts } from "@/lib/content";
import { SITE } from "@/config";
import { getPostImage } from "@/lib/post-image";

const posts = (await getAllPosts()).slice(0, 30);

// Feed is for discovery; duplicate-content territory, so keep it out of
// the index. Canonical points to /feed/ itself so shares don't redirect.
const seo = {
  title: `Feed — ${SITE.title}`,
  description: "Parcourez tous nos articles en mode feed vertical, comme sur votre app préférée.",
  canonicalUrl: `${SITE.website.replace(/\/$/, "")}/feed/`,
  robots: "noindex, follow, max-image-preview:large",
  openGraph: {
    title: `Feed — ${SITE.title}`,
    description: "Parcourez tous nos articles en mode feed vertical.",
    type: "website" as const,
  },
  jsonLd: "",
};
---

<Layout seo={seo} type="website" fullScreen>
  <a
    href="/"
    class="fixed top-4 right-4 z-50 flex size-10 items-center justify-center rounded-full bg-black/50 text-white backdrop-blur-md transition hover:bg-black/70"
    aria-label="Fermer le feed et revenir à l'accueil"
  >
    <svg
      aria-hidden="true"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </a>

  <main
    id="feed-scroller"
    class="h-dvh w-full snap-y snap-mandatory overflow-y-scroll overscroll-contain bg-black"
    style="scrollbar-width:none;-ms-overflow-style:none;"
    aria-label="Articles en mode feed vertical"
  >
    {
      posts.map((post, idx) => {
        const catLabel = post.categories[0]
          ? post.categories[0].replace(/-/g, " ")
          : "";
        const image = getPostImage(post);
        return (
          <article
            id={`feed-${idx}`}
            class="relative flex h-dvh w-full snap-start items-end overflow-hidden"
            aria-labelledby={`feed-title-${idx}`}
          >
            <img
              src={image.src}
              alt={image.alt}
              loading={idx < 2 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={idx === 0 ? "high" : "auto"}
              width={image.width}
              height={image.height}
              class="absolute inset-0 h-full w-full object-cover"
            />
            {/* Gradient overlay for readability */}
            <div
              aria-hidden="true"
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10"
            />

            <div class="relative z-10 mx-auto w-full max-w-xl px-6 pt-20 pb-24 text-white sm:pb-28">
              {catLabel && (
                <p class="font-accent text-[11px] tracking-[0.15em] uppercase text-white/80 mb-3">
                  {catLabel}
                  <span class="mx-2 opacity-40" aria-hidden="true">|</span>
                  <span class="opacity-70">{post.author.name}</span>
                </p>
              )}
              <h2
                id={`feed-title-${idx}`}
                class="font-display text-3xl leading-tight font-semibold tracking-tight sm:text-4xl"
              >
                {post.title}
              </h2>
              <p class="mt-3 line-clamp-3 text-sm text-white/85 sm:text-base">
                {post.excerpt}
              </p>
              <a
                href={`/${post.slug}/`}
                class="mt-5 inline-flex items-center gap-2 rounded-full bg-white/95 px-5 py-2.5 text-sm font-semibold text-black transition hover:bg-white"
              >
                Lire l'article
                <svg
                  aria-hidden="true"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>

            {/* Counter + swipe hint */}
            <div
              aria-hidden="true"
              class="absolute top-5 left-5 z-10 rounded-full bg-black/40 px-3 py-1 text-xs font-medium text-white/90 backdrop-blur-md"
            >
              {idx + 1} / {posts.length}
            </div>
            {idx < posts.length - 1 && (
              <div
                aria-hidden="true"
                class="absolute right-0 bottom-4 left-0 z-10 flex justify-center"
              >
                <span class="animate-bounce rounded-full bg-white/15 px-3 py-1 text-xs text-white/80 backdrop-blur-md">
                  Glissez vers le haut
                </span>
              </div>
            )}
          </article>
        );
      })
    }

    {/* End marker */}
    <div
      class="relative flex h-dvh w-full snap-start items-center justify-center bg-background px-6 text-center"
    >
      <div>
        <p class="kicker mb-2">Fin du feed</p>
        <h2 class="display-md mb-4">Vous avez tout vu.</h2>
        <p class="mb-6 max-w-sm text-foreground/70">
          Explorez toutes nos catégories ou revenez au feed pour redécouvrir
          les articles.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/"
            class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
          >
            Accueil
          </a>
          <a
            href="#feed-0"
            class="rounded-full border border-accent px-5 py-2.5 text-sm font-semibold text-accent hover:bg-accent hover:text-white"
          >
            Recommencer
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  /* Hide WebKit scrollbar on the feed specifically */
  #feed-scroller::-webkit-scrollbar {
    display: none;
  }
  /* Keyboard nav friendliness: focus on article enables arrow keys */
  #feed-scroller article:focus {
    outline: none;
  }
</style>

<script>
  // Arrow-key navigation between slides (desktop QoL).
  function installFeedKeys() {
    const scroller = document.querySelector<HTMLElement>("#feed-scroller");
    if (!scroller) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        const articles = Array.from(
          scroller.querySelectorAll<HTMLElement>("article, div[class*='snap-start']")
        );
        const y = scroller.scrollTop;
        const vh = scroller.clientHeight;
        const currentIdx = Math.round(y / vh);
        const next =
          e.key === "ArrowDown"
            ? Math.min(currentIdx + 1, articles.length - 1)
            : Math.max(currentIdx - 1, 0);
        scroller.scrollTo({ top: next * vh, behavior: "smooth" });
      }
    };
    window.addEventListener("keydown", onKey);
    // Clean up on page swap
    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("keydown", onKey),
      { once: true }
    );
  }
  installFeedKeys();
  document.addEventListener("astro:after-swap", installFeedKeys);
</script>
