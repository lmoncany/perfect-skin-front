---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { getPageBySlug, getPostBySlug, getRelatedPosts } from "@/lib/content";
import { SITE } from "@/config";

const slug = Astro.params.slug;

if (!slug) {
  Astro.response.status = 404;
}

const [post, page] = slug
  ? await Promise.all([getPostBySlug(slug), getPageBySlug(slug)])
  : [null, null];
const entry = post ?? page;

if (!entry) {
  Astro.response.status = 404;
}

const related = post ? await getRelatedPosts(post, 4) : [];
---

{
  entry ? (
    post ? (
      <ArticleLayout post={post} related={related} />
    ) : page ? (
      <PageLayout page={page} />
    ) : (
      <Layout
        title={`404 — ${SITE.title}`}
        description="La page demandée est introuvable."
      >
        <Header />
        <main id="main-content" class="app-layout py-24">
          <p class="kicker mb-3">404</p>
          <h1 class="display-lg mb-4">Page introuvable</h1>
          <p class="max-w-xl text-base sm:text-lg text-foreground/50 leading-relaxed font-light">
            Le contenu demandé n’existe pas ou n’est plus disponible.
          </p>
        </main>
        <Footer />
      </Layout>
    )
  ) : (
    <Layout
      title={`404 — ${SITE.title}`}
      description="La page demandée est introuvable."
    >
      <Header />
      <main id="main-content" class="app-layout py-24">
        <p class="kicker mb-3">404</p>
        <h1 class="display-lg mb-4">Page introuvable</h1>
        <p class="max-w-xl text-base sm:text-lg text-foreground/50 leading-relaxed font-light">
          Le contenu demandé n’existe pas ou n’est plus disponible.
        </p>
      </main>
      <Footer />
    </Layout>
  )
}
