---
import type { GetStaticPaths } from "astro";
import ArchiveLayout from "@/layouts/ArchiveLayout.astro";
import { getBrands, getPostsByBrand } from "@/lib/content";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const brands = await getBrands();
  const results = [];
  for (const b of brands) {
    const posts = await getPostsByBrand(b.slug);
    if (posts.length === 0) continue;
    const paths = paginate(posts, {
      params: { brand: b.slug },
      pageSize: SITE.postPerPage,
      props: { brandName: b.name, brandDesc: b.description },
    });
    results.push(...paths);
  }
  return results;
}) satisfies GetStaticPaths;

const { page, brandName, brandDesc } = Astro.props;

const title = `${brandName} — avis, tests et comparatifs | ${SITE.title}`;
const description =
  brandDesc ||
  `Tous nos articles sur la marque ${brandName} — avis, tests et comparatifs.`;
---

<ArchiveLayout
  title={title}
  description={description}
  pageTitle={brandName}
  intro={brandDesc}
  page={page}
/>
