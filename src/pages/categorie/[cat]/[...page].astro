---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArchiveLayout from "@/layouts/ArchiveLayout.astro";
import { SITE } from "@/config";
import { getCategory, getPostsByCategory } from "@/lib/content";
import { buildRuntimePage, parsePageNumber } from "@/lib/runtime-pagination";

const cat = Astro.params.cat;
const pageParam = Astro.params.page;

if (!cat) {
  Astro.response.status = 404;
}

const category = cat ? await getCategory(cat) : null;
const currentPage = parsePageNumber(pageParam);

if (!category) {
  Astro.response.status = 404;
}

const posts = category ? await getPostsByCategory(category.slug) : [];
const page = buildRuntimePage(
  posts,
  currentPage,
  SITE.postPerPage,
  `/categorie/${category?.slug ?? cat}/`
);
const invalidPage = !!category && currentPage > page.lastPage;

if (invalidPage) {
  Astro.response.status = 404;
}

const title = category ? `${category.name} — ${SITE.title}` : `404 — ${SITE.title}`;
const description = category
  ? category.description || `Articles beauté et soins de la catégorie ${category.name}.`
  : "Catégorie introuvable.";
---

{
  category && !invalidPage ? (
    <ArchiveLayout
      title={title}
      description={description}
      pageTitle={category.name}
      intro={category.description}
      page={page}
    />
  ) : (
    <Layout title={title} description={description}>
      <Header />
      <main id="main-content" class="app-layout py-24">
        <p class="kicker mb-3">404</p>
        <h1 class="display-lg mb-4">Catégorie introuvable</h1>
        <p class="max-w-xl text-base sm:text-lg text-foreground/50 leading-relaxed font-light">
          La catégorie demandée n’existe pas ou n’est plus disponible.
        </p>
      </main>
      <Footer />
    </Layout>
  )
}
