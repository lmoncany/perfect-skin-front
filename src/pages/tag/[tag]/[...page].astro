---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArchiveLayout from "@/layouts/ArchiveLayout.astro";
import { SITE } from "@/config";
import { getTag, getPostsByTag } from "@/lib/content";
import { buildRuntimePage, parsePageNumber } from "@/lib/runtime-pagination";

const tag = Astro.params.tag;
const pageParam = Astro.params.page;

if (!tag) {
  Astro.response.status = 404;
}

const tagEntry = tag ? await getTag(tag) : null;
const currentPage = parsePageNumber(pageParam);

if (!tagEntry) {
  Astro.response.status = 404;
}

const posts = tagEntry ? await getPostsByTag(tagEntry.slug) : [];
const page = buildRuntimePage(posts, currentPage, SITE.postPerPage, `/tag/${tagEntry?.slug ?? tag}/`);
const invalidPage = !!tagEntry && currentPage > page.lastPage;

if (invalidPage) {
  Astro.response.status = 404;
}

const title = tagEntry ? `#${tagEntry.name} — ${SITE.title}` : `404 — ${SITE.title}`;
const description = tagEntry
  ? `Tous les articles autour du thème « ${tagEntry.name} » sur ${SITE.title}.`
  : "Tag introuvable.";
---

{
  tagEntry && !invalidPage ? (
    <ArchiveLayout
      title={title}
      description={description}
      pageTitle={`#${tagEntry.name}`}
      intro={`Articles tagués « ${tagEntry.name} »`}
      page={page}
    />
  ) : (
    <Layout title={title} description={description}>
      <Header />
      <main id="main-content" class="app-layout py-24">
        <p class="kicker mb-3">404</p>
        <h1 class="display-lg mb-4">Tag introuvable</h1>
        <p class="max-w-xl text-base sm:text-lg text-foreground/50 leading-relaxed font-light">
          Le tag demandé n’existe pas ou n’est plus disponible.
        </p>
      </main>
      <Footer />
    </Layout>
  )
}
