---
import type { GetStaticPaths } from "astro";
import ArchiveLayout from "@/layouts/ArchiveLayout.astro";
import { getPostsByTag, getTags } from "@/lib/content";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const tags = await getTags();
  const results = [];
  for (const t of tags) {
    const posts = await getPostsByTag(t.slug);
    if (posts.length === 0) continue;
    const paths = paginate(posts, {
      params: { tag: t.slug },
      pageSize: SITE.postPerPage,
      props: { tagName: t.name },
    });
    results.push(...paths);
  }
  return results;
}) satisfies GetStaticPaths;

const { page, tagName } = Astro.props;

const title = `#${tagName} — ${SITE.title}`;
const description = `Tous les articles autour du thème « ${tagName} » sur ${SITE.title}.`;
---

<ArchiveLayout
  title={title}
  description={description}
  pageTitle={`#${tagName}`}
  intro={`Articles tagués « ${tagName} »`}
  page={page}
/>
