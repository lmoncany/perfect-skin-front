---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { getTags } from "@/lib/content";
import { SITE } from "@/config";

const tags = await getTags();
const sortedTags = [...tags].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<Layout
  title={`Mots-clés — ${SITE.title}`}
  description="Tous les mots-clés et thèmes éditoriaux publiés sur Perfect Skin."
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <header class="mt-4 mb-8">
      <h1 class="font-serif text-3xl font-bold text-foreground sm:text-4xl">
        Mots-clés
      </h1>
      <p class="mt-3 max-w-2xl text-foreground/75">
        Explorez les thèmes, ingrédients et sujets les plus couverts sur Perfect Skin.
      </p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sortedTags.map(tag => (
          <li>
            <a
              href={`/tag/${tag.slug}/`}
              class="block rounded-xl border border-border bg-card p-5 transition hover:border-accent hover:shadow-md"
            >
              <h2 class="font-serif text-lg font-bold">#{tag.name}</h2>
              <p class="mt-1 text-sm text-foreground/70">
                {tag.count} article{tag.count > 1 ? "s" : ""}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <Footer />
</Layout>
