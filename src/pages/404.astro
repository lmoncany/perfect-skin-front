---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
---

<Layout title={`Page introuvable — ${SITE.title}`}>
  <Header />
  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center text-center">
      <p class="kicker mb-4">Page introuvable</p>
      <h1 class="font-display text-8xl font-light text-foreground/15">404</h1>
      <p class="mt-6 font-display text-2xl font-medium sm:text-3xl">
        Cette page n'existe pas.
      </p>
      <p class="mt-3 max-w-md text-foreground/45 font-light">
        Le lien que vous suivez a peut-être été déplacé. Essayez la recherche
        ou retrouvez nos dernières actualités beauté.
      </p>
      <div class="mt-8 flex gap-4">
        <LinkButton
          href="/"
          class="px-6 py-2.5 font-accent text-[11px] font-medium tracking-[0.15em] uppercase bg-foreground text-background hover:bg-accent transition-colors duration-300"
        >
          Accueil
        </LinkButton>
        <LinkButton
          href="/search/"
          class="px-6 py-2.5 font-accent text-[11px] font-medium tracking-[0.15em] uppercase border border-foreground/20 text-foreground hover:border-accent hover:text-accent transition-colors duration-300"
        >
          Rechercher
        </LinkButton>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
