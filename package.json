{
  "name": "psk-front",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Headless Astro frontend for perfect-skin.fr — French beauty/wellness magazine powered by WordPress + WPGraphQL.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "cf:login": "wrangler login",
    "cf:deploy": "astro build && wrangler pages deploy dist --project-name=psk-front --branch=main",
    "cf:deploy:preview": "astro build && wrangler pages deploy dist --project-name=psk-front --branch=preview",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.6",
    "dayjs": "^1.11.19",
    "lodash.kebabcase": "^4.1.1",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/cloudflare": "^12.0.0",
    "@pagefind/default-ui": "^1.4.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "wrangler": "^4.93.1"
  }
}
