# ---- Perfect Skin frontend env ----
# Copy to .env.local for local dev. If WORDPRESS_API_URL is unset, the site
# renders from mock fixtures in src/lib/mock-data.ts (handy for first builds).

# WPGraphQL endpoint. Example: https://admin.perfect-skin.fr/graphql
WORDPRESS_API_URL=

# Optional. Format: "username:application_password". Only needed if your
# GraphQL endpoint is behind Basic Auth for bots.
WORDPRESS_APP_PASSWORD=

# Shared secret used by the WP → frontend cache-bust webhook.
# Generate a long random string: `openssl rand -hex 32`
REVALIDATE_SECRET=

# Optional — Google Search Console verification tag value
PUBLIC_GOOGLE_SITE_VERIFICATION=
